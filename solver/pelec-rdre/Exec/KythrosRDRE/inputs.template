# Kythros-generated PeleC RDRE case. Values use PeleC cgs units.
max_step = 100000000
stop_time = {{STOP_TIME_S}}

geometry.is_periodic = 0 0 0
geometry.coord_sys = 0
geometry.prob_lo = 0.0 {{DOMAIN_LOW_CM}} {{DOMAIN_LOW_CM}}
geometry.prob_hi = {{CHAMBER_LENGTH_CM}} {{DOMAIN_HIGH_CM}} {{DOMAIN_HIGH_CM}}
